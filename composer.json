{
    "name": "goletter/hyperf-openapi",
    "description": "Hyperf OpenAPI 3\uff1a\u81ea\u52a8\u626b\u63cf\u5206\u53d1 Controller \u751f\u6210\u6587\u6863\uff0c\u53ef\u76f4\u63a5\u5bfc\u5165 Apifox\uff08\u65e0\u9700\u6ce8\u89e3\uff09\u3002",
    "type": "library",
    "version": "1.0.3",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "openapi",
        "apifox",
        "swagger",
        "goletter"
    ],
    "require": {
        "php": ">=8.1",
        "hyperf/command": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/contract": "~3.1.0",
        "hyperf/http-server": "~3.1.0"
    },
    "suggest": {
        "symfony/yaml": "\u751f\u6210 openapi.yaml \u65f6\u9700\u8981\uff08^6|^7\uff09\u3002",
        "hyperf/validation": "\u4ece FormRequest::rules() \u63a8\u65ad requestBody \u65f6\u9700\u8981\u3002",
        "hyperf/database": "\u8bc6\u522b Model \u8def\u7531\u53c2\u6570 {id} \u65f6\u9700\u8981\u3002",
        "hyperf/framework": "\u4f7f\u7528 ConfigProvider / DI / Listener \u65f6\u9700\u8981\u3002"
    },
    "autoload": {
        "psr-4": {
            "Goletter\\OpenApi\\": "src/"
        }
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\OpenApi\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
